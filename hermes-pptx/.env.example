# Copy to .env and fill in. Never commit .env.
HERMES_UID=1000
HERMES_GID=1000

# Optional host path mounted read-only at /projects inside the container
# PROJECTS_PATH=/path/to/your/projects

# OpenAI-compatible API gateway auth (clients → Hermes)
# Generate: openssl rand -base64 32
API_SERVER_KEY=change-me-to-a-long-random-string
API_SERVER_ENABLED=true
API_SERVER_HOST=0.0.0.0

# Ports (optional overrides)
# HERMES_API_PORT=8642
# HERMES_DASHBOARD_PORT=9119
# OPEN_WEBUI_PORT=3080

# ── LLM providers (at least one required) ──────────────────────────
# Default config uses DeepSeek Flash. OpenRouter is great for Claude/Opus.

# DeepSeek (https://platform.deepseek.com/)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# OpenRouter (https://openrouter.ai/keys) — multi-model gateway
OPENROUTER_API_KEY=

# Optional direct providers
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=
# GEMINI_API_KEY=

# Optional tools
# FIRECRAWL_API_KEY=
